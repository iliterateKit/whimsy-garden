---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'

const projects = await getAllProjects()
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="mt-0">
         Hello! Did you come here from my flyers across the city? I'm a 20-something-year-old who's just moved to DC for a museum education job. My hobbies include origami, books (both accumulating and reading), theatre, photography, video games, and learning new things, but I'm generally excited to try anything new!
        </p>
        <p class="mt-0"></p>
        This is my personal blog for whatever comes to mind. I'm still fleshing it out, and sections are a WIP, but I hope you enjoy this slice of my mind! Feel free to email me at iliterateKit@gmail.com or text me at (404)-692-1595. And of course, check out some of my writing! Maybe. 
        </p>
      </div>
<!--
      <h2 class="mb-4 text-2xl font-medium">Example Projects Listing</h2>
      <div class="flex flex-col gap-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    -->
    </div>
  </section>
</Layout>
